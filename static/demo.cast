[0.001, "o", "C\u001b[1B\"Heart\u001b[10Gattack\"\u001b[18Gis\u001b[21Ga\u001b[23Grecorded\u001b[32Gsynonym\u001b[40Gof\u001b[43Gthis\u001b[48Gconcept,\u001b[57Gso\u001b[60Git\u001b[63Gcame\u001b[68Gback\u001b[73Gas\u001b[76Gan\u001b[79Gexact\u001b[85Gmatch.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BThe\u001b[7Glookup\u001b[14Galso\u001b[19Greturned\u001b[28G\u001b[1m4134723, Coronary artery thrombosis\u001b[22m.\u001b[65GIt\u001b[68Gonly\u001b[73Gmatched\u001b[81Gbecause\u001b[89Ga\u001b[91Gbroader\u001b[99Gnon-standard\u001b[112Gconcept,\r\u001b[2C\u001b[1B\"Myocardial infa\u001b[20Gc\u001b[22Gio\u001b[25G (& [acute]) or coronary thrombosis\" (40345176), maps to it. That\u001b[91Gmakes it a weaker mat\u001b[113Gh, so\u001b[K\r\u001b[2C\u001b[1B4329847 \u001b[12Gs the one t\u001b[24G use.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIf\u001b[6Gyou're\u001b[13Gbuilding\u001b[22Ga\u001b[24Gcohort,\u001b[32Guse\u001b[36G4329847\u001b[44Gwith\u001b[49Gits\u001b[53Gdescendants\u001b[65Gso\u001b[68Gthat\u001b[73Gmore\u001b[78Gspecific\u001b[87Gtypes,\u001b[94Gsuch\u001b[99Gas\u001b[102Gacute\u001b[108GMI,\u001b[112Gare\r\u001b[2C\u001b[1Bincluded.\u001b[13G\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 17s · done 6:57 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mWhich drugs make up the FOLFOX regimen, as OMOP standard RxNorm ingredients?\u001b[39m            "]
