[0.001, "o", "pts\u001b[51G(35803077,\u001b[62G35803081,\u001b[72G35803227).\u001b[83GThose\u001b[89Gare\u001b[93Gnon-standard,\u001b[107Gso\u001b[110Gdon't\u001b[116Guse\r\u001b[2C\u001b[1Bthem\u001b[8Gfor\u001b[12Gdrug\u001b[17Gexposure\u001b[26Gqueries.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mBuilding a cohort:\u001b[24G\u001b[22minclude\u001b[32Gthe\u001b[36Gdescendants\u001b[48Gof\u001b[51Geach\u001b[56Gingredient\u001b[67Gso\u001b[70Gthat\u001b[75Gclinical\u001b[84Gand\u001b[88Gbranded\u001b[96Gdrug\u001b[101Grecords\u001b[109Gare\r\u001b[2C\u001b[1B \u001b[5Gcaptured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLeucovorin variants:\u001b[26G\u001b[22mif\u001b[29Gyour\u001b[34Gdata\u001b[39Grecords\u001b[47Glevoleucovorin\u001b[62Gas\u001b[65Ga\u001b[67Gsubstitute,\u001b[79Git\u001b[82Gis\u001b[85Ga\u001b[87Gseparate\u001b[96Gingredient\u001b[107Gand\u001b[111Gisn't\u001b[117Gone\r\u001b[2C\u001b[1B \u001b[5Gof the three above.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFOLFOX chronotherapy:\u001b[27G\u001b[22mthis\u001b[32Gis\u001b[35Ga\u001b[37Gseparate\u001b[46Gregimen\u001b[54Gconcept\u001b[62G(35804808).\u001b[74GI\u001b[76Gdidn't\u001b[83Gcheck\u001b[89Gits\u001b[93Gcomponents.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 9s · done 6:57 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI would lik\u001b[15G a concept set covering colorectal\u001b[50Gca\u001b[53Gcer. This conc\u001b"]
