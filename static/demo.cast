[0.009, "o", "\u001b[K\r\u001b[8C\u001b[1B\u001b[1mso\u001b[13Gd tumours (782):\u001b[22m every ICD-O-3 haematolymphoid code (histology 9590–9999), plus Lymphoma of colon\u001b[K\r\u001b[4C\u001b[1B(37018876), of sigm\u001b[25Gid colon (40486168) an\u001b[49Gof appendix\u001b[61G(603015).\r\u001b[4C\u001b[1B\u001b[1mNon-malignant (29):\u001b[22m in situ codes (ICD-O-3 behaviour\u001b[58G/2).\u001b[63GBenign and uncertain-behaviour concepts aren't\u001b[110Gu\u001b[113Ger the\u001b[K\r\u001b[4C\u001b[1Bmalignant parent, so\u001b[26Gthey\u001b[31Gwere never\u001b[42Gpulled\u001b[49Gin.\r\u001b[4C\u001b[1B\u001b[1mAnal (25):\u001b[22m 23 ICD-O-3 cloacogen\u001b[37Gc-zone (C21.2) codes that the hierar\u001b[74Ghy file\u001b[82G u\u001b[85Gde\u001b[88G rectum, plus 4095430\u001b[110Gand 438090,\r\u001b[4C\u001b[1Bwhich combine \u001b[21Gctum with anu\u001b[35G.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSecondary involvement (7):\u001b[32G\u001b[22m\"Malignant\u001b[43Gtumor\u001b[49Ginvolving\u001b[59Grectum\u001b[66Gby\u001b[69Gdirect\u001b[76Gextension\u001b[86Gfrom…\"\u001b[93Govary,\u001b[100Gprostate,\u001b[110Gcervix\u001b[117Gand\r\u001b[2C\u001b[1B  so on. These are other cancers\u001b[36Gspreading\u001b[46Ginto\u001b[51Gthe\u001b[55Grectum.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChoices you may want to revisit:\r\u001b[2C\u001b[1B\u001b[22m1\u001b[6G\u001b[1mAppendix:\u001b[22m ICD-10"]
[0.002, "o", " puts it inside C18, but most col\u001b[56Grectal cancer definitions leave it\u001b[91Gout. Drop or keep that group\r\u001b[5C\u001b[1Bas you need.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSolid tumours other than carcinoma are kept:\u001b[51G\u001b[22mneuroendocrine\u001b[66Gtumours,\u001b[75GGIST,\u001b[81Gsarcomas,\u001b[91GKaposi\u001b[98Gsarcoma\u001b[106G(608057)\u001b[115Gand\r\u001b[2C\u001b[1B  \u001b[6Gmelanoma of rectum (4171274). If\u001b[39Gyou want carcinoma or adenocarcinoma o\u001b[78Gly, I\u001b[84Gcan\u001b[88Gfilter b\u001b[98GICD-O-3 h\u001b[108Gstology \u001b[117Gnd\u001b[K\r\u001b[5C\u001b[1BSNOMED\u001b[13Gname.\u001b[19G\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mNot included:\u001b[20G\u001b[22mMedDRA\u001b[27G\"colorectal\u001b[39Gcancer\"\u001b[47Gterms,\u001b[54Gbecause\u001b[62Gthey're\u001b[70Gnon-standard,\u001b[84Gand\u001b[88Gsecondary\u001b[98G(metastatic)\u001b[111Gneoplasms\r\u001b[2C\u001b[1B \u001b[5G of\u001b[9Gthe colo\u001b[19Gor rectum.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gcan\u001b[9Galso\u001b[14Gturn\u001b[19Gthis\u001b[24Ginto\u001b[29Gan\u001b[32GATLAS\u001b[38Gconcept-set\u001b[50GJSON\u001b[55Gper\u001b[59Ggroup,\u001b[66Gor\u001b[69Gcheck\u001b[75Git\u001b[78Gagainst\u001b[86Gthe\u001b[90GCQI\u001b[94Glibrary\u001b[102Gwith\r\u001b[1B \u001b[3G\u001b[38;2;177;185;249mcqi_workers_concept_usage\u001b[39m.\u001b[K\r\u001b[2B\u001b[38;2;153;153;153m✻\u001b[39m \u001b[38;2;"]
