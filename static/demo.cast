[0.038, "o", "\u001b[?25l\u001b[H\u001b[3G2\u001b[6G\u001b[1mS\u001b[8Glid tumours other than carcinoma are kept:\u001b[22m neuroendocrin\u001b[65G tumours, GIST, sarcoma\u001b[89G, Kaposi\u001b[98Gsarcoma (608057) and\u001b[K\r\u001b[5C\u001b[1Bmelanoma of rectum (4171274).\u001b[36GIf\u001b[39Gyou\u001b[43Gwant\u001b[48Gcarcinoma\u001b[58Gor\u001b[61Gadenocarcinoma\u001b[76Gonly,\u001b[82GI\u001b[84Gcan\u001b[88Gfilter\u001b[95Gby\u001b[98GICD-O-3\u001b[106Ghistology\u001b[116Gand\r\u001b[5C\u001b[1BSNOMED\u001b[13Gname.\r\u001b[2C\u001b[1B3. \u001b[1mNot included:\u001b[22m MedDRA \"colorectal cancer\" terms, because they'\u001b[68Ge non-standard, and secondary (metas\u001b[105Gatic)\u001b[111Gneoplasms\r\u001b[2C\u001b[1B   of the colon or rectum\r\u001b[2B \u001b[3GI can also turn this into an ATLAS\u001b[38Gconcept-set\u001b[50GJSON\u001b[55Gper\u001b[59Ggroup,\u001b[66Gor\u001b[69Gcheck\u001b[75Git\u001b[78Gagainst\u001b[86Gthe\u001b[90GCQI\u001b[94Glibrary\u001b[102Gwith\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mcqi_workers_concept_usage\u001b[39m.\r\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 1m 46s · done 6:59 pm\r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mLet's audit the concept set specific to the ascending colon to check for completeness\u001b[39m                "]
[0.003, "o", "                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mI've found a red flag: core histology\u001b[41Gcodes\u001b[47Glike\u001b[52G8140/3\u001b[59GAdenocarcinoma\u001b[74GNOS,\u001b[79G8000/3,\u001b[87Gand\u001b[91G8010/3\u001b[98Gare\u001b[102Gmissing\u001b[110Gat\u001b[113Gthe\r\u001b[2C\u001b[1Bascending\u001b[13Gcolon\u001b[19G(C18.2).\u001b[28GI'll\u001b[33Gcheck\u001b[39Gwhether\u001b[47Gthese\u001b[53Gconcepts\u001b[62Gexist\u001b[68Goutside\u001b[76Gthe\u001b[80Ghierarchy\u001b[90GI\u001b[92Gused.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled groundworkers \u001b[1m4\u001b[22m times \u001b[39m\u001b[K\r\u001b[2B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mThose weren't true gaps — 8140/3,\u001b[37G8000/3,\u001b[45Gand\u001b[49G8010/3\u001b[56Gat\u001b[59GC18.2\u001b[65Gexist\u001b[71Gbut\u001b[75Gare\u001b[79Gnon-standard,\u001b[93Gmapped\u001b[100Gto\u001b[103Ga\u001b[105Gstandard\u001b[114Gconcept\r\u001b[2C\u001b[1Bvia\u001b[7G\"Maps\u001b[13Gto.\"\u001b[18GNow\u001b[22Gchecking\u001b[31Gwhere\u001b[37Gall\u001b[41G41\u001b[44Gmissing\u001b[52Ghistology\u001b[62Gcodes\u001b[68Gmap\u001b[72Gand\u001b[76Gwhether\u001b[84Gthose\u001b[90Gtargets\u001b[98Gare\u001b[102Galready\u001b[110Gincluded.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled groundworkers \u001b[1m9\u001b[22m times \u001b[33"]
