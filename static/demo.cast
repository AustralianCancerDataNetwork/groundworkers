[0.097, "o", "\u001b[?25l\u001b[H\u001b[3G\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gput\u001b[9Gthe\u001b[13Gtransverse\u001b[24Gcolon i\u001b[32G the right colon,\u001b[50Gfollowing\u001b[60Gthe\u001b[64Gusual\u001b[70Gsplit\u001b[76Gat\u001b[79Gthe\u001b[83Gsplenic\u001b[91Gflexure.\u001b[100GMoving\u001b[107Git\u001b[110Gis\u001b[113Ga\u001b[116G\u001b[K\r\u001b[2C\u001b[1Bone-line change in the script.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mExcluded (842 concepts):\u001b[22m\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mNon-solid tumours (782):\u001b[30G\u001b[22mevery\u001b[36GICD-O-3\u001b[44Ghaematolymphoid\u001b[60Gcode\u001b[65G(histology\u001b[76G9590–9999),\u001b[88Gplus\u001b[93GLymphoma\u001b[102Gof\u001b[105Gcolon\r\u001b[2C\u001b[1B \u001b[5G(37018876), of sigmoid colon (40486168) and o\u001b[51G appendix (603015).\u001b[K\r\u001b[2C\u001b[1B- \u001b[1mNon-malignant (29):\u001b[22m in s\u001b[30Gtu codes\u001b[39G(ICD-O-3\u001b[48Gbehaviour\u001b[58G/2).\u001b[63GBenign\u001b[70Gand\u001b[74Guncertain-behaviour\u001b[94Gconcepts\u001b[103Garen't\u001b[110Gunder\u001b[116Gthe\r\u001b[4C\u001b[1Bmalignant\u001b[15Gparent,\u001b[23Gso\u001b[26Gthey\u001b[31Gwere\u001b[36Gnever\u001b[42Gpulled\u001b[49Gin.\r\u001b[2C\u001b[1B- \u001b[1mAnal (25):\u001b[22m 23 ICD-O-3 cloacogenic-zone\u001b[44G(C21.2)\u001b[52Gcodes\u001b[58Gthat\u001b[63Gthe\u001b[67Ghierarchy\u001b[77Gfiles\u001b[83Gunder\u001b[89Grectum,\u001b[97Gplus\u001b[102G4095430\u001b[110Gand\u001b[114G438090,"]
[0.001, "o", "\r\u001b[2C\u001b[1B \u001b[5Gwhich combine rectum with anus.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mSecondary involvement (7):\u001b[22m \"Malignant tumor\u001b[49Ginvolvi\u001b[57Gg rectum by direct\u001b[76Gextension\u001b[86Gfrom…\"\u001b[93Govary,\u001b[100Gprostate,\u001b[110Gcervix\u001b[117Gand\r\u001b[2C\u001b[1B \u001b[5Gso on. These are other\u001b[28Gcancers spreading into the rectum\u001b[63G\u001b[K\r\u001b[4C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChoices you may want to revisit:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mAppendix:\u001b[22m ICD-10 puts it\u001b[31Gi\u001b[33Gside\u001b[38GC18,\u001b[43Gbut\u001b[47Gmost\u001b[52Gcolorectal\u001b[63Gcancer\u001b[70Gdefinitions\u001b[82Gleave\u001b[88Git\u001b[91Gout.\u001b[96GDrop\u001b[101Gor\u001b[104Gkeep\u001b[109Gthat\u001b[114Ggroup\r\u001b[2C\u001b[1B \u001b[5G as you need.\u001b[K\r\u001b[2C\u001b[1B2. \u001b[1mSolid tumours other than carcinoma are kept:\u001b[51G\u001b[22mneuro\u001b[57Gndocrine\u001b[66Gtumours,\u001b[75GGIST,\u001b[81Gsarcomas,\u001b[91GKaposi\u001b[98Gsarcoma\u001b[106G(608057)\u001b[115Gand\r\u001b[5C\u001b[1Bmelanoma\u001b[15Gof\u001b[18Grectum\u001b[25G(4171274).\u001b[36GIf\u001b[39Gyou\u001b[43Gwant\u001b[48Gcarcinoma\u001b[58Gor\u001b[61Gadenocarcinoma\u001b[76Gonly,\u001b[82GI\u001b[84Gcan\u001b[88Gfilter\u001b[95Gby\u001b[98GICD-O-3\u001b[106Ghistology\u001b[116Gand\r\u001b[2C\u001b[1B   SNOMED name.\u001b[K\r\u001b[2C\u001b[1B3\u001b[6G\u001b[1mNot included:\u001b"]
[0.002, "o", "[22m MedDRA \"colorectal cancer\"\u001b[47Gterms, because they're\u001b[70Gnon-standard, \u001b[85Gnd\u001b[88Gsec\u001b[92Gndary (metastatic) neoplasms\r\u001b[5C\u001b[1Bof\u001b[9Gthe\u001b[13Gcolon\u001b[19Gor\u001b[22Grectum.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gcan \u001b[10Glso turn this into an ATLAS concept-set JSON per group, or \u001b[70Gheck it against the CQI library with\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;177;185;249mcqi_workers_concept_usage\u001b[39m.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GWorked for 1m 46s · done 6:59 pm\r\u001b[2B\u001b[48;2;55;55;55m❯ \u001b[38;2;255;255;255mLet's audit the concept set specific to the ascending colon to check for completeness\u001b[39m                                 \r\u001b[2C\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mRan \u001b[1m1\u001b[22m shell command \r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mI've\u001b[8Gfound\u001b[14Ga\u001b[16Gred\u001b[20Gflag:\u001b[26Gcore\u001b[31Ghistology\u001b[41Gcodes\u001b[47Glike\u001b[52G8140/3\u001b[59GAdenocarcinoma\u001b[74GNOS,\u001b[79G8000/3,\u001b[87Gand\u001b[91G8010/3\u001b[98Gare\u001b[102Gmissing\u001b[110Gat\u001b[113Gthe\r\u001b[1B  ascending colon (C18.2). I'll check whether these concepts exist outside the hierarchy I used.\u001b"]
