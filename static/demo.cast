[0.118, "o", "\u001b[?25l\u001b[H\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[3G\u001b[39mThe\u001b[7Gfile\u001b[12Gis\u001b[15Gsmall:\u001b[22Ga\u001b[24Gheader\u001b[31Grow\u001b[35Gand\u001b[39G8\u001b[41Gfields.\r\u001b[1B\u001b[K\r\u001b[2C\u001b[1B┌───────────────┬────────────────────────────────┬────────────┬───────┐\r\u001b[2C\u001b[1B│  field_name   │          field_label           │ field_type │ units │\r\u001b[2C\u001b[1B├───────────────┼────────────────────────────────┼────────────┼───────┤\r\u001b[2C\u001b[1B│ bmi           │ Body mass index                │ number     │ kg/m2 │\r\u001b[2C\u001b[1B├───────────────┼────────────────────────────────┼────────────┼───────┤\r\u001b[2C\u001b[1B│ hba1c         │ Haemoglobin A1"]
