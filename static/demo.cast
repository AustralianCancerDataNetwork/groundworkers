[0.001, "o", "9Gare\r\u001b[2C\u001b[1B \u001b[5Gcaptured.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mLeucovorin variants:\u001b[26G\u001b[22mif\u001b[29Gyour\u001b[34Gdata\u001b[39Grecords\u001b[47Glevoleucovorin\u001b[62Gas\u001b[65Ga\u001b[67Gsubstitute,\u001b[79Git\u001b[82Gis\u001b[85Ga\u001b[87Gseparate\u001b[96Gingredient\u001b[107Gand\u001b[111Gisn't\u001b[117Gone\r\u001b[2C\u001b[1B \u001b[5Gof the three above.\u001b[K\r\u001b[2C\u001b[1B-\u001b[5G\u001b[1mFOLFOX chronotherapy:\u001b[27G\u001b[22mthis\u001b[32Gis\u001b[35Ga\u001b[37Gseparate\u001b[46Gregimen\u001b[54Gconcept\u001b[62G(35804808).\u001b[74GI\u001b[76Gdidn't\u001b[83Gcheck\u001b[89Gits\u001b[93Gcomponents.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GCooked for 9s · done 6:57 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;55;55;55m\u001b[38;2;153;153;153m❯ \u001b[38;2;255;255;255mI would like a concept set covering colorectal cancer. This concept set should be split into groups covering each of \u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mthe major r\u001b[15Glevant anatomical regions. Exclude\u001b[50Gno\u001b[53G-malignant dis\u001b[68Gase and n\u001b[78Gn-solid tumors.\u001b[39m                           \r\u001b[1B\u001b[49m\u001b[K\r\u001b[2C\u001b[1B\u001b[38;2;153;153;153mCalled groundworkers \u001b[1m8\u001b[22m times, ran \u001b[1m2\u001b[22m shell commands \r\u001b[2C\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[38;2;255;"]
