[0.092, "o", "\u001b[?25l\u001b[H\u001b[5Gso on. These are other canc\u001b[34Gs\u001b[36Gspr\u001b[40Gading into the\u001b[55Grectum.\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1B\u001b[1mChoices you may want to revisit:\u001b[22m\u001b[K\r\u001b[2C\u001b[1B1. \u001b[1mAppendix:\u001b[22m ICD-10 puts it inside C18,\u001b[43Gb\u001b[45Gt most colorectal cancer definitions leave it out. Drop or keep that group\u001b[K\r\u001b[4C\u001b[1B as you n\u001b[15Ged.\u001b[K\r\u001b[2C\u001b[1B2.\u001b[6G\u001b[1mSolid tumours other than carcinoma are kept:\u001b[51G\u001b[22mneuroendocrine\u001b[66Gtumours,\u001b[75GGIST,\u001b[81Gsarcomas,\u001b[91GKaposi\u001b[98Gsarcoma\u001b[106G(608057)\u001b[115Gand\r\u001b[2C\u001b[1B   melanoma of rectum (4171274).\u001b[36GIf\u001b[39Gyou\u001b[43Gwant\u001b[48Gcarcinoma\u001b[58Gor\u001b[61Gadenocarcinoma\u001b[76Gonly,\u001b[82GI\u001b[84Gcan\u001b[88Gfilter\u001b[95Gby\u001b[98GICD-O-3\u001b[106Ghistology\u001b[116Gand\r\u001b[2C\u001b[1B  \u001b[6GSNOMED name.\u001b[K\r\u001b[2C\u001b[1B3.\u001b[6G\u001b[1mNot included:\u001b[20G\u001b[22mMedDRA\u001b[27G\"colorectal\u001b[39Gcancer\"\u001b[47Gterms,\u001b[54Gbecause\u001b[62Gthey're\u001b[70Gnon-standard,\u001b[84Gand\u001b[88Gsecondary\u001b[98G(metastatic)\u001b[111Gneoplasms\r\u001b[2C\u001b[1B  \u001b[6Gof the colon or rectum.\u001b[K\r\u001b[5C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BI\u001b[5Gcan also turn\u001b[19Gthis\u001b[24Ginto\u001b[29Gan\u001b[32GATLAS\u001b[38Gconcept-set\u001b[5"]
