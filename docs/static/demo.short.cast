[1.0871, "o", "\u001b[?25l\u001b[3;1H\u001b[0m\u001b[K\u001b[4;1H\u001b[0;38;2;255;255;255m⏺\u001b[0m Yes. The morphology route works and gives an independent confirmation, and it caught one problem the hierarchy checks\u001b[0m\u001b[K\u001b[5;1H\u001b[0m  couldn't see: \u001b[0;1msource codes for benign carcinoid tumour flow into concepts that are in the set.\u001b[0m\u001b[K\u001b[6;1H\u001b[0m\u001b[K\u001b[7;1H\u001b[0m  \u001b[0;1mHow the bridge works\u001b[0m\u001b[K\u001b[8;1H\u001b[0m\u001b[K\u001b[9;1H\u001b[0m  ┌────────────────┬────────────────────────────────┬──────────────────────────────────────────────────────────────┐\u001b[0m\u001b[K\u001b[10;1H\u001b[0m  │  Concept type  │              Link              │                          Points to                           │\u001b[0m\u001b[K\u001b[11;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[12;1H\u001b[0m  │ SNOMED         │ Has asso morph                 │ SNOMED morphology, e.g. 4029971 Large cell neuroendocrine    │\u001b[0m\u001b[K\u001b[13;1H\u001b[0m  │ disorder       │                                │ carcinoma                                                    │\u001b[0m\u001b[K\u001b[14;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[15;1H\u001b[0m  │ SNOMED         │ Mapped from                    │ ICD-O-3 histology, e.g. 44498657 = 8013/3 (the behaviour     │\u001b[0m\u001b[K\u001b[16;1H\u001b[0m  │ morphology     │                                │ code is in the histology)                                    │\u001b[0m\u001b[K\u001b[17;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[18;1H\u001b[0m  │ ICD-O-3        │ Has Histology ICDO / Has       │ Histology concept / topography concept 44498122 \"Ascending   │\u001b[0m\u001b[K\u001b[19;1H\u001b[0m  │ condition      │ Topography ICDO                │ colon\" (C18.2)                                               │\u001b[0m\u001b[K\u001b[20;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[21;1H\u001b[0m  │ Any disorder   │ Has finding site               │ Anatomy concept 4234702 \"Ascending colon structure\"          │\u001b[0m\u001b[K\u001b[22;1H\u001b[0m  └────────────────┴────────────────────────────────┴──────────────────────────────────────────────────────────────┘\u001b[0m\u001b[K\u001b[23;1H\u001b[0m\u001b[K\u001b[24;1H\u001b[0m  Neither the topography nor the finding-site link depends on the \"Is a\" hierarchy, so each gives a separate list of\u001b[0m\u001b[K\u001b[25;1H\u001b[0m  ascending colon concepts.\u001b[0m\u001b[K\u001b[26;1H\u001b[0m\u001b[K\u001b[27;1H\u001b[0m  \u001b[0;1m1. ICD-O-3 conditions linked to topography C18.2 (210)\u001b[0m\u001b[K\u001b[28;1H\u001b[0m  - 108 are in the included file. That is every included ICD-O-3 ascending concept.\u001b[0m\u001b[K\u001b[29;1H\u001b[0m  - 68 are in the excluded file: haematologic and in situ.\u001b[0m\u001b[K\u001b[30;1H\u001b[0m  - 23 are non-malignant (/0, /1, /2), except \u001b[0;1m44502762\u001b[0m, the gap found in the last audit.\u001b[0m\u001b[K\u001b[31;1H\u001b[0m  - 11 are in neither file, and all are non-standard. 4 map to SNOMED concepts already in the set (44502439, 44504346,\u001b[0m\u001b[K\u001b[32;1H\u001b[0m    44504349, 36568351). The other 7 correctly stay out:\u001b[0m\u001b[K\u001b[33;1H\u001b[0m    - 2 metastatic (711472, 44504347), which map to the Cancer Modifier concept 35226034 \"Metastasis to ascending colon\"\u001b[0m\u001b[K\u001b[34;1H\u001b[0m    - in situ, adenoma, benign and uncertain behaviour\u001b[0m\u001b[K\u001b[35;1H\u001b[0m    - \u001b[0;1m42511421 \"Neoplasm defined only by topography\"\u001b[0m, which maps to 4130997 \"Neoplasm of ascending colon\"; behaviour\u001b[0m\u001b[K\u001b[36;1H\u001b[0m      isn't known\u001b[0m\u001b[K\u001b[37;1H\u001b[0m\u001b[K\u001b[38;1H\u001b[0m  \u001b[0;1m2. Concepts with finding site Ascending colon structure (234)\u001b[0m\u001b[K\u001b[39;1H\u001b[0m  - This finds \u001b[0;1m761001\u001b[0m and \u001b[0;1m44502762\u001b[0m again. These are the same two gaps, now confirmed by a third method.\u001b[0m\u001b[K\u001b[40;1H\u001b[0m  - Everything else not in the set is in situ, benign, metastatic-to-colon (37168957, 4312150) or inactive lymphoma.\u001b[0m\u001b[K\u001b[41;1H\u001b[0m  - The one included concept that has neither link is 36715911 \"Primary adenocarcinoma of ascending colon and right\u001b[0m\u001b[K\u001b[42;1H\u001b[0m    flexure\". Its finding site is the hepatic flexure (right colic flexure, 4168005), so it is still correctly in the\u001b[0m\u001b[K\u001b[43;1H\u001b[0m    right colon group.\u001b[0m\u001b[K"]
[1.0871, "o", "\u001b[?25l\u001b[3;1H\u001b[0;38;2;255;255;255m⏺\u001b[0m Yes. The morphology route works and gives an independent confirmation, and it caught one problem the hierarchy checks\u001b[0m\u001b[K\u001b[4;1H\u001b[0m  couldn't see: \u001b[0;1msource codes for benign carcinoid tumour flow into concepts that are in the set.\u001b[0m\u001b[K\u001b[5;1H\u001b[0m\u001b[K\u001b[6;1H\u001b[0m  \u001b[0;1mHow the bridge works\u001b[0m\u001b[K\u001b[7;1H\u001b[0m\u001b[K\u001b[8;1H\u001b[0m  ┌────────────────┬────────────────────────────────┬──────────────────────────────────────────────────────────────┐\u001b[0m\u001b[K\u001b[9;1H\u001b[0m  │  Concept type  │              Link              │                          Points to                           │\u001b[0m\u001b[K\u001b[10;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[11;1H\u001b[0m  │ SNOMED         │ Has asso morph                 │ SNOMED morphology, e.g. 4029971 Large cell neuroendocrine    │\u001b[0m\u001b[K\u001b[12;1H\u001b[0m  │ disorder       │                                │ carcinoma                                                    │\u001b[0m\u001b[K\u001b[13;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[14;1H\u001b[0m  │ SNOMED         │ Mapped from                    │ ICD-O-3 histology, e.g. 44498657 = 8013/3 (the behaviour     │\u001b[0m\u001b[K\u001b[15;1H\u001b[0m  │ morphology     │                                │ code is in the histology)                                    │\u001b[0m\u001b[K\u001b[16;1H\u001b[0m  ├────────────────┼────────────────────────────────┼──────────────────────────────────────────────────────────────┤\u001b[0m\u001b[K\u001b[17;1H\u001b[0m  │ ICD-O-3        │ Has Histology ICDO / Has       │ Histology concept / topography concept 44498122 \"Ascending   │