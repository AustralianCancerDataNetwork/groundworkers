[0.001, "o", "6Gfor\r\u001b[2C\u001b[1Bexample\u001b[11Gprimary\u001b[19Gmalignant\u001b[29Gneuroendocrine\u001b[44Gneoplasm\u001b[53Gof\u001b[56Gthe\u001b[60Gcecum,\u001b[67Gtransverse\u001b[78Gcolon\u001b[84Gand\u001b[88Grectum.\u001b[96GRe-rooting\u001b[107Gthe\u001b[111Gbuild\u001b[117Gat\r\u001b[2C\u001b[1B\u001b[1mNeoplas\u001b[11G of large intestine (4130514)\u001b[22m and k\u001b[47Geping only\u001b[58Gmalignant concept\u001b[76G would fix every group at once. Th\u001b[111G filter\u001b[K\r\u001b[2C\u001b[1Bwould use ICD-O-3 behaviour /3 a\u001b[37G SNOMED malignant anc\u001b[59Gstry or\u001b[67Gname\u001b[72G, and\u001b[78GI'd re-run this audit per region. Do you\u001b[K\r\u001b[2C\u001b[1Bwant me to do that?\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GChurned for 2m 5s · done 7:01 pm\r\u001b[2B\u001b[48;2;28;46;82m\u001b[38;2;122;162;247m❯ \u001b[1m\u001b[38;2;255;255;255mCould we use the snomed morphology property to map backwards to ICDO3 and provide additional confirmation that way as\u001b[22m\u001b[39m \r\u001b[1B  \u001b[38;2;255;255;255mwell?\u001b[39m                                                                                                                 \r\u001b[1B\u001b[49m\u001b[K\r\u001b[1B\u001b[38;2;255;255;255m⏺\u001b[39m\u001b[K\u001b[48;1H\u001b[46;3H\u001b[?25h"]
