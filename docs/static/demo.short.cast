b[K\u001b[23;1H\u001b[0m  ├──────────────┼────────────┼────────────────────┼──────────┤\u001b[0m\u001b[K\u001b[24;1H\u001b[0m  │ fluorouracil │ \u001b[0;1m955632\u001b[0m     │ RxNorm Ingredient  │ S        │\u001b[0m\u001b[K\u001b[25;1H\u001b[0m  ├──────────────┼────────────┼────────────────────┼──────────┤\u001b[0m\u001b[K\u001b[26;1H\u001b[0m  │ leucovorin   │ \u001b[0;1m1388796\u001b[0m    │ RxNorm Ingredient  │ S        │\u001b[0m\u001b[K\u001b[27;1H\u001b[0m  ├──────────────┼────────────┼────────────────────┼──────────┤\u001b[0m\u001b[K\u001b[28;1H\u001b[0m  │ oxaliplatin  │ \u001b[0;1m1318011\u001b[0m    │ RxNorm Ingredient  │ S        │\u001b[0m\u001b[K\u001b[29;1H\u001b[0m  └──────────────┴────────────┴────────────────────┴──────────┘\u001b[0m\u001b[K\u001b[30;1H\u001b[0m\u001b[K\u001b[31;1H\u001b[0m  These come from the HemOnc regimen concept \u001b[0;1mFOLFOX (35806596)\u001b[0m, through its \"Has cytotox chemo Rx\" relationships. The\u001b[0m\u001b[K\u001b[32;1H\u001b[0m  regimen also links to HemOnc component concepts (35803077, 35803081, 35803227). Those are non-standard, so don't use\u001b[0m\u001b[K\u001b[33;1H\u001b[0m  them for drug exposure queries.\u001b[0m\u001b[K\u001b[34;1H\u001b[0m\u001b[K\u001b[35;1H\u001b[0m  - \u001b[0;1mBuilding a cohort:\u001b[0m include the descendants of each ingredient so that clinical and branded drug records are\u001b[0m\u001b[K\u001b[36;1H\u001b[0m    captured.\u001b[0m\u001b[K\u001b[37;1H\u001b[0m  - \u001b[0;1mLeucovorin variants:\u001b[0m if your data records levoleucovorin as a substitute, it is a separate ingredient and isn't one\u001b[0m\u001b[K\u001b[38;1H\u001b[0m    of the three above.\u001b[0m\u001b[K\u001b[39;1H\u001b[0m  - \u001b[0;1mFOLFOX chronotherapy:\u001b[0m this is a separate regimen concept (35804808). I didn't check its components.\u001b[0m\u001b[K\u001b[40;1H\u001b[0m\u001b[K\u001b[41;1H\u001b[0;38;2;153;153;153m✻\u001b[0m \u001b[0;38;2;153;153;153mCooked for 9s · done 6:57 pm\u001b[0m\u001b[K