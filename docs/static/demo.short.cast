0 overlapping                   │     │\u001b[0m\u001b[K\u001b[33;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[34;1H\u001b[0m  │ 4. Rectosigmoid       │ C19.9                                      │ 4180792, 438699                     │ 119 │\u001b[0m\u001b[K\u001b[35;1H\u001b[0m  │ junction              │                                            │                                     │     │\u001b[0m\u001b[K\u001b[36;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[37;1H\u001b[0m  │ 5. Rectum             │ C20.9                                      │ 443390, 74582                       │ 147 │\u001b[0m\u001b[K\u001b[38;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[39;1H\u001b[0m  │ 6. Colorectal, site   │ Large intestine or colorectal NOS,         │ 443396, 37168850, 37018659,         │     │\u001b[0m\u001b[K\u001b[40;1H\u001b[0m  │ unspecified           │ overlapping colon and rectum, MSI-H,       │ 42537577                            │ 12  │\u001b[0m\u001b[K\u001b[41;1H\u001b[0m  │                       │ Lynch-type terms                           │                                     │     │\u001b[0m\u001b[K\u001b[42;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[43;1H\u001b[0m  │ Optional: Appendix    │ C18.                                       │                                     │     │\u001b[0m\u001b[K\u001b[44;1H\u001b[0m  └───────────────────────┴────────────────────────────────────────────┴─────────────────────────────────────┴─────┘\u001b[0m\u001b[K"]
