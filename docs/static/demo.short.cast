│\u001b[0m\u001b[K\u001b[14;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[15;1H\u001b[0m  │ 5. Rectum             │ C20.9                                      │ 443390, 74582                       │ 147 │\u001b[0m\u001b[K\u001b[16;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[17;1H\u001b[0m  │ 6. Colorectal, site   │ Large intestine or colorectal NOS,         │ 443396, 37168850, 37018659,         │     │\u001b[0m\u001b[K\u001b[18;1H\u001b[0m  │ unspecified           │ overlapping colon and rectum, MSI-H,       │ 42537577                            │ 12  │\u001b[0m\u001b[K\u001b[19;1H\u001b[0m  │                       │ Lynch-type terms                           │                                     │     │\u001b[0m\u001b[K\u001b[20;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[21;1H\u001b[0m  │ Optional: Appendix    │ C18.1                                      │ 443383                              │ 118 │\u001b[0m\u001b[K\u001b[22;1H\u001b[0m  └───────────────────────┴────────────────────────────────────────────┴─────────────────────────────────────┴─────┘\u001b[0m\u001b[K\u001b[23;1H\u001b[0m\u001b[K\u001b[24;1H\u001b[0m  I put the transverse colon in the right colon, following the usual split at the splenic flexure. Moving it is a\u001b[0m\u001b[K\u001b[25;1H\u001b[0m  one-line change in the script.\u001b[0m\u001b[K\u001b[26;1H\u001b[0m\u001b[K\u001b[27;1H\u001b[0m  \u001b[0;1mExcluded (842 concepts):\u001b[0m\u001b[K\u001b[28;1H\u001b[0m  - \u001b[0;1mNon-solid tumours (782):\u001b[0m every ICD-O-3 haematolymphoid code (histology 9590–9999), plus Lymphoma of colon\u001b[0m\u001b[K\u001b[29;1H\u001b[0m    (37018876), of sigmoid colon (40486168) and of appendix (603015).\u001b[0m\u001b[K\u001b[30;1H\u001b[0m  - \u001b[0;1mNon-malignant (29):\u001b[0m in situ codes (ICD-O-3 behaviour /2). Benign and uncertain-behaviour concepts aren't under the\u001b[0m\u001b[K\u001b[31;1H\u001b[0m    malignant parent, so they were never pulled in.\u001b[0m\u001b[K\u001b[32;1H\u001b[0m  - \u001b[0;1mAnal (25):\u001b[0m 23 ICD-O-3 cloacogenic-zone (C21.2) codes that the hierarchy files under rectum, plus 4095430 and 438090,\u001b[0m\u001b[K\u001b[33;1H\u001b[0m    which combine rectum with anus.\u001b[0m\u001b[K\u001b[34;1H\u001b[0m  - \u001b[0;1mSecondary involvement (7):\u001b[0m \"Malignant tumor involving rectum by direct extension from…\" ovary, prostate, cervix and\u001b[0m\u001b[K\u001b[35;1H\u001b[0m    so on. These are other cancers spreading into the rectum.\u001b[0m\u001b[K\u001b[36;1H\u001b[0m\u001b[K\u001b[37;1H\u001b[0m  \u001b[0;1mChoices you may want to revisit:\u001b[0m\u001b[K\u001b[38;1H\u001b[0m\u001b[K\u001b[39;1H\u001b[0m  1. \u001b[0;1mAppendix:\u001b[0m ICD-10 puts it inside C18, but most colorectal cancer definitions leave it out. Drop or keep that group\u001b[0m\u001b[K\u001b[40;1H\u001b[0m     as you need.\u001b[0m\u001b[K\u001b[41;1H\u001b[0m  2. \u001b[0;1mSolid tumours other than carcinoma are kept:\u001b[0m neuroendocrine tumours, GIST, sarcomas, Kaposi sarcoma (608057) and\u001b[0m\u001b[K\u001b[42;1H\u001b[0m     melanoma of rectum (4171274). If you want carcinoma or adenocarcinoma only, I can filter by ICD-O-3 histology and\u001b[0m\u001b[K\u001b[43;1H\u001b[0m     SNOMED name.\u001b[0m\u001b[K\u001b[44;1H\u001b[0m  3.\u001b[0m\u001b[K"]
[0.087, "o", "\u001b[?25l\u001b[1;1H\u001b[0m  │ 1. Right (proximal)   │ Cecum (and ileocecal valve), ascending     │ 443391 cecum, 435754 ascending,     │     │\u001b[0m\u001b[K\u001b[2;1H\u001b[0m  │ colon                 │ colon, hepatic flexure, transverse colon   │ 4180791 hepatic flexure, 443384     │ 464 │\u001b[0m\u001b[K\u001b[3;1H\u001b[0m  │                       │                                            │ transverse                          │     │\u001b[0m\u001b[K\u001b[4;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[5;1H\u001b[0m  │ 2. Left (distal)      │ Splenic flexure, descending colon, sigmoid │ 4181344 splenic flexure, 443382     │ 353 │\u001b[0m\u001b[K\u001b[6;1H\u001b[0m  │ colon                 │  colon                                     │ descending, 443381 sigmoid          │     │\u001b[0m\u001b[K\u001b[7;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[8;1H\u001b[0m  │ 3. Colon, overlapping │ Colon NOS, overlapping lesions of colon    │ 4180790 Malignant tumor of colon,   │ 242 │\u001b[0m\u001b[K\u001b[9;1H\u001b[0m  │  or unspecified       │ (C18.8/C18.9)                              │ 79740 overlapping                   │     │\u001b[0m\u001b[K\u001b[10;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[11;1H\u001b[0m  │ 4. Rectosigmoid       │ C19.9                                      │ 4180792, 438699                     │ 119 │\u001b[0m\u001b[K\u001b[12;1H\u001b[0m  │ junction              │                                            │                                     │     │\u001b[0m\u001b[K\u001b[13;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[14;1H\u001b[0m  │ 5. Rectum             │ C20.9                                      │ 443390, 74582                       │ 147 │\u001b[0m\u001b[K\u001b[15;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[16;1H\u001b[0m  │ 6. Colorectal, site   │ Large intestine or colorectal NOS,         │ 443396, 37168850, 37018659,         │     │\u001b[0m\u001b[K\u001b[17;1H\u001b[0m  │ unspecified           │ overlapping colon and rectum, MSI-H,       │ 42537577                            │ 12  │\u001b[0m\u001b[K\u001b[18;1H\u001b[0m  │                       │ Lynch-type terms                           │                                     │     │\u001b[0m\u001b[K\u001b[19;1H\u001b[0m  ├───────────────────────┼────────────────────────────────────────────┼─────────────────────────────────────┼─────┤\u001b[0m\u001b[K\u001b[20;1H\u001b[0m  │ Optional: Appendix    │ C18.1                                      │ 443383                              │ 118 │\u001b[0m\u001b[K\u001b[21;1H\u001b[0m  └───────────────────────┴────────────────────────────────────────────┴─────────────────────────────────────┴─────┘\u001b[0m\u001b[K\u001b[22;1H\u001b[0m\u001b[K\u001b[23;1H\u001b[0m  I put the transverse colon in the right colon, following the usual split at the splenic flexure. Moving it is a\u001b[0m\u001b[K\u001b[24;1H\u001b[0m  one-line change in the script.\u001b[0m\u001b[K\u001b[25;1H\u001b[0m\u001b[K\u001b[26;1H\u001b[0m  \u001b[0;1mExcluded (842 concepts):\u001b[0m\u001b[K\u001b[27;1H\u001b[0m  - \u001b[0;1mNon-solid tumours (782):\u001b[0m every ICD-O-3 haematolymphoid code (histology 9590–9999), plus Lymphoma of colon\u001b[0m\u001b[K\u001b[28;1H\u001b[0m    (37018876), of sigmoid colon (40486168) and of appendix (603015).\u001b[0m\u001b[K\u001b[29;1H\u001b[0m  - \u001b[0;1mNon-malignant (29):\u001b[0m in situ codes (ICD-O-3 behaviour /2). Benign and uncertain-behaviour concepts aren't under the\u001b[0m\u001b[K\u001b[30;1H\u001b[0m    malignant parent, so they were never pulled in.\u001b[0m\u001b[K\u001b[31;1H\u001b[0m  - \u001b[0;1mAnal (25):\u001b[0m 23 ICD-O-3 cloacogenic-zone (C21.2) codes that the hierarchy files under rectum, plus 4095430 and 438090,\u001b[0m\u001b[K\u001b[32;1H\u001b[0m    which combine rectum with anus.\u001b[0m\u001b[K\u001b[33;1H\u001b[0m  - \u001b[0;1mSecondary involvement (7):\u001b[0m \"Malignant tumor involving rectum by direct extension from…\" ovary, prostate, cervix and\u001b[0m\u001b[K\u001b[34;1H\u001b[0m    so on. These are other cancers spreading into the rectum.\u001b[0m\u001b[K\u001b[35;1H\u001b[0m\u001b[K\u001b[36;1H\u001b[0m  \u001b[0;1mChoices you may want to revisit:\u001b[0m\u001b[K\u001b[37;1H\u001b[0m\u001b[K\u001b[38;1H\u001b[0m  1. \u001b[0;1mAppendix:\u001b[0m ICD-10 puts it inside C18, but most colorectal cancer definitions leave it out. Drop or keep that group\u001b[0m\u001b[K\u001b[39;1H\u001b[0m     as you need.\u001b[0m\u001b[K\u001b[40;1H\u001b[0m  2. \u001b[0;1mSolid tumours other than carcinoma are kept:\u001b[0m neuroendocrine tumours, GIST, sarcomas, Kaposi sarcoma (608057) and\u001b[0m\u001b[K\u001b[41;1H\u001b[0m     melanoma of rectum (4171274). If you want carcinoma or adenocarcinoma only, I can filter by ICD-O-3 histology and\u001b[0m\u001b[K\u001b[42;1H\u001b[0m     SNOMED name.\u001b[0m\u001b[K\u001b[43;1H\u001b[0m  3.\u001b[0m\u001b[K\u001b[44;1H\u001b[0m\u001b[K"]
