[0.0007, "o", "─────────────┴────────────┴───────┘\r\u001b[2C\u001b[1B\u001b[K\r\u001b[2C\u001b[1BIt\u001b[6Ghas\u001b[10Gthree\u001b[16Gnumeric\u001b[24Gmeasurements\u001b[37Gwith\u001b[42Gunits\u001b[48Gand\u001b[52Gfive\u001b[57Gyes/no\u001b[64Gflags,\u001b[71Gbut\u001b[75Gno\u001b[78Gfield\u001b[84Gfor\u001b[88Gdiagnosis,\u001b[99Gsite\u001b[104Gor\u001b[107Ghistology.\r\u001b[2C\u001b[1BThat means it can't us\u001b[26G the colorectal\u001b[42Gcancer concept\u001b[57Gs\u001b[59Gt from earlier.\u001b[75GI can map these field\u001b[97G to OMOP concepts if\u001b[118Gyou\r\u001b[2C\u001b[1Bwan\u001b[7G.\u001b[K\r\u001b[2C\u001b[1B\u001b[K\r\u001b[1B\u001b[38;2;153;153;153m✻\u001b[3GBaked for 7s · done 7:03 pm\r\u001b[1B\u001b[39m\u001b[K\r\u001b[1B\u001b[48;2;28;46;82m\u001b[38;2;122;162;247m❯ \u001b[1m\u001b[38;2;255;255;255mUse groundworkers to plan the source, then map each field to a standard OMOP concept.\u001b[22m\u001b[39m                                 \r\u001b[1B  \u001b[38;2;255;255;255mReturn o\u001b[12Ge table:\u001b[21Gfield_\u001b[28Game,\u001b[33Gfield_label,\u001b[46GOMOP domain, concept_id, concept_name, vocabulary, match type.\r\u001b[2C\u001b[1BFlag any row you are not confident about.\u001b[39m                                                             "]
