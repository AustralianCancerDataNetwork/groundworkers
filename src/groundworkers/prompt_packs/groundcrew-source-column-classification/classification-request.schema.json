{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.groundcrew/schemas/source-column-classification-request.schema.json",
  "title": "Groundcrew source-column classification request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "table_name",
    "headers",
    "original_headers",
    "sample_rows",
    "deterministic_annotations",
    "candidate_headers"
  ],
  "properties": {
    "table_name": {"type": "string", "minLength": 1},
    "headers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "original_headers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "sample_rows": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": {"type": ["string", "null"]}
      }
    },
    "deterministic_annotations": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/annotation"}
    },
    "candidate_headers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  },
  "$defs": {
    "role": {
      "enum": [
        "label",
        "codes",
        "values",
        "annotation",
        "entity",
        "attribute",
        "section",
        "subsection",
        "source_vocab",
        "description",
        "mapping_context",
        "data_type",
        "field_type_ctrl",
        "local_pk",
        "pii_flag",
        "required",
        "frequency",
        "pipeline_meta",
        "irrelevant"
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "detection_tier", "confidence", "inferred_vocab", "packed_value", "notes"],
      "properties": {
        "role": {"$ref": "#/$defs/role"},
        "detection_tier": {"enum": ["A", "B", "C", "D", "LLM"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "inferred_vocab": {"type": ["string", "null"]},
        "packed_value": {"type": "boolean"},
        "notes": {"type": "string"}
      }
    }
  }
}

